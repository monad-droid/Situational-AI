# Choose your AI provider — you only need ONE of these.
# Everything runs on YOUR machine using YOUR credits. No server costs.

# Option 1: Anthropic (recommended)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Option 2: OpenAI
OPENAI_API_KEY=sk-xxxxx

# Anthropic model (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# How often to check thresholds and nag (in minutes, default: 60)
# CHECK_INTERVAL_MINUTES=60

# How aggressive the coach should be (1-10, default: 7)
# COACH_INTENSITY=7
